{
  "manifest_version": 3,
  "name": "SnapShift - Cinematic Vanish & Reappear",
  "version": "1.0.0",
  "description": "Real-time AI webcam effects. Perform a physical snap to disintegrate into particles and vanish; snap again to reappear.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SnapShift Controls",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "interceptor.js",
        "wasm/*",
        "models/*",
        "studio.html",
        "output.html"
      ],
      "matches": ["https://meet.google.com/*"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "commands": {
    "disappear": {
      "suggested_key": {
        "default": "Ctrl+Shift+D"
      },
      "description": "Trigger Disappearance"
    },
    "reappear": {
      "suggested_key": {
        "default": "Ctrl+Shift+R"
      },
      "description": "Trigger Reappearance"
    },
    "reset": {
      "suggested_key": {
        "default": "Ctrl+Shift+0"
      },
      "description": "Reset Effect to Normal Camera"
    }
  }
}
